{
  "name": "topengineer-education-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "npm run build && npm run test:pricing && npm run test:sites",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:pricing": "node --test tests/reference-pricing.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
